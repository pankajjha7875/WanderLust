<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-lg-8 offset-lg-2">
    <h1 class="bookings-title">My Bookings</h1>

    <% if (bookings.length === 0) { %>
      <div class="booking-empty">
        <p>No bookings yet.</p>
        <a href="/listings" class="btn btn-dark">Browse stays</a>
      </div>
    <% } %>

    <% for (let b of bookings) { %>
      <div class="card booking-card mb-4">
        <div class="row g-0">

          <div class="col-md-4">
            <% if (b.listing && b.listing.image && b.listing.image.url) { %>
              <img src="<%= b.listing.image.url %>" class="booking-img" alt="<%= b.listing.title %>" />
            <% } else { %>
              <div class="booking-img d-flex align-items-center justify-content-center bg-light">
                <span class="text-muted">No image</span>
              </div>
            <% } %>
          </div>

          <div class="col-md-8">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <% if (b.listing) { %>
                  <h5 class="card-title">
                    <a href="/listings/<%= b.listing._id %>"><%= b.listing.title %></a>
                  </h5>
                <% } else { %>
                  <h5 class="card-title">Listing no longer available</h5>
                <% } %>
                <span class="status-badge status-<%= b.status %>"><%= b.status %></span>
              </div>

              <% if (b.listing) { %>
                <p class="text-muted mb-2"><%= b.listing.location %>, <%= b.listing.country %></p>
              <% } %>

              <div class="booking-meta">
                <span><b>Check-in:</b> <%= b.checkIn.toDateString() %></span>
                <span><b>Check-out:</b> <%= b.checkOut.toDateString() %></span>
                <span><b>Guests:</b> <%= b.guests %></span>
              </div>

              <div class="d-flex justify-content-between align-items-center">
                <span class="booking-total">&#8377;<%= b.totalPrice.toLocaleString("en-IN") %></span>
                <% if (b.status === "confirmed") { %>
                  <form action="/bookings/<%= b._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-sm btn-outline-danger">Cancel booking</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>

        </div>
      </div>
    <% } %>
  </div>
</div>