<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-3">
        </div>
<div class="card col-6 offset-3 show-card mt-4">
    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="<%= listing.title %>">
  <div class="card-body">
    <p class="card-text">
       <b><%= listing.title %></b><br />
       <%= listing.description %><br />
       Price:&#x20B9;<%= listing.price.toLocaleString("en-IN") %><br />
       Location: <%= listing.location %><br />
         Country: <%= listing.country %>
    </p>
  </div>
</div>
<br>
</div>
<div class="btns">
<a 
    href="/listings/<%= listing._id %>/edit" 
    class="btn btn-dark col-1 offset-3 edit-btn">
    Edit</a>
<form 
method="POST"
action="/listings/<%=listing._id%>?_method=DELETE">
    <button 
     class="btn btn-dark edit-btn offset-5">
        Delete
    </button>
</form>
</div>

<!-- ===== Booking ===== -->
<div class="row mt-4 mb-5">
  <div class="col-6 offset-3">
    <hr />
    <h4>Book this stay</h4>

    <% if (currentUser) { %>
      <form
        action="/listings/<%= listing._id %>/bookings"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <div class="mb-3">
          <label for="checkIn" class="form-label">Check-in</label>
          <input type="date" name="booking[checkIn]" id="checkIn" class="form-control" required />
          <div class="invalid-feedback">Please choose a check-in date.</div>
        </div>

        <div class="mb-3">
          <label for="checkOut" class="form-label">Check-out</label>
          <input type="date" name="booking[checkOut]" id="checkOut" class="form-control" required />
          <div class="invalid-feedback">Please choose a check-out date.</div>
        </div>

        <div class="mb-3">
          <label for="guests" class="form-label">Guests</label>
          <input
            type="number"
            name="booking[guests]"
            id="guests"
            class="form-control"
            min="1"
            value="1"
            required
          />
        </div>

        <p id="bookingTotal" class="fw-bold"></p>

        <button class="btn btn-success">Book Now</button>
      </form>

      <script>
        (function () {
          const pricePerNight = <%= listing.price || 0 %>;
          const checkIn = document.getElementById("checkIn");
          const checkOut = document.getElementById("checkOut");
          const total = document.getElementById("bookingTotal");

          const today = new Date().toISOString().split("T")[0];
          checkIn.min = today;
          checkOut.min = today;

          function update() {
            if (checkIn.value) {
              const next = new Date(checkIn.value);
              next.setDate(next.getDate() + 1);
              checkOut.min = next.toISOString().split("T")[0];
            }
            if (checkIn.value && checkOut.value) {
              const nights = Math.round(
                (new Date(checkOut.value) - new Date(checkIn.value)) / 86400000
              );
              if (nights > 0) {
                total.textContent =
                  nights + " night(s) x \u20B9" + pricePerNight.toLocaleString("en-IN") +
                  " = \u20B9" + (nights * pricePerNight).toLocaleString("en-IN");
                return;
              }
            }
            total.textContent = "";
          }

          checkIn.addEventListener("change", update);
          checkOut.addEventListener("change", update);
        })();
      </script>
    <% } else { %>
      <p><a href="/login">Log in</a> to book this stay.</p>
    <% } %>
  </div>
</div>


