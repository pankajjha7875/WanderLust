<%layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <h3>Edit Listing</h3>
    <form  method="POST" action="/listings/<%= listing._id %>?_method=PUT">
            <div class="mb-3">
            <label>Title:</label>
            <input type="text" 
            name="listing[title]" 
            value="<%= listing.title %>" 
            required 
            class="form-control" />
        </div>
        <div class="mb-3">
            <label>image:</label>
            <input type="text" 
            name="listing[image]" 
            value="<%= listing.image %>" 
            required 
            class="form-control" />
        </div>

        <div class="mb-3">
            <label>Description:</label>
            <textarea name="listing[description]" 
            required 
            class="form-control"><%= listing.description %>
            </textarea>
        </div>
     <div class="row ">
<div class="mb-3 col-md-4">
            <label>Price:</label>
            <input type="number" 
            name="listing[price]" 
            value="<%= listing.price %>" 
            required 
            class="form-control" />
        </div>

        <div class="mb-3 col-md-8">
            <label>Country:</label>
            <input type="text" 
            name="listing[country]" 
            value="<%= listing.country %>" 
            required 
            class="form-control" />
        </div>
     </div>
        <button class="btn btn-dark edit-btn mt-3">Edit</button>
    </form>
    <br /><br />
     <a href="/listings/<%= listing._id %>">Cancel</a>
 </div>
</div>



